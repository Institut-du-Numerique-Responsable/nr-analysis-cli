    },
    "bugs": {
        "url": "https://github.com/Institut-du-Numerique-Responsable/nr-analysis-cli/issues"
    },
    "author": "Institut du Numérique Responsable (https://institutnr.org)",
    "license": "AGPL-3.0-or-later",
    "bin": {
        "nr": "nr"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "nr",
        "builder.js",
        "sizes.js",
